# CORS Proxy Dockerfile for Tutanota
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy CORS proxy package files
COPY cors-anywhere/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy CORS proxy source code
COPY cors-anywhere/ ./

# Expose port
EXPOSE 8080

# Start CORS proxy server
CMD ["node", "server.js"] 